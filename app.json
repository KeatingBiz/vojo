{
  "expo": {
    "name": "Vojo",
    "slug": "vojo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "vojo",
    "userInterfaceStyle": "dark",
    "ios": {
      "bundleIdentifier": "com.jacobkeating.vojo",
      "supportsTablet": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "appleTeamId": "UUT2Y46GNR"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0F0F23",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.jacobkeating.vojo"
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0F0F23",
          "image": "./assets/splash/mojo-out.png",
          "imageWidth": 240
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Vojo uses the microphone to record your speaking sessions."
        }
      ],
      "expo-video"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "backgroundColor": "#0F0F23"
  }
}